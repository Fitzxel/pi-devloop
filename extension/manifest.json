{
  "manifest_version": 3,
  "name": "Pi Devloop Feedback",
  "version": "1.0.0",
  "description": "Select page elements and send feedback to Pi devloop.",
  "key": "",
  "permissions": ["activeTab"],
  "host_permissions": [],
  "background": { "service_worker": "service-worker.js" },
  "commands": {
    "toggle-overlay": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "Toggle the Pi devloop feedback overlay"
    }
  },
  "action": { "default_title": "Pi Devloop feedback", "default_popup": "popup.html" }
}
